# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.
# CHANGED: one file for the whole repo. Patterns without a slash match in any folder;
# patterns that start with frontend/ or backend/ match only there.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
# CHANGED: was /.idea, which only matched the repo root; .idea/ matches Rider's folder anywhere (backend/.idea)
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
# CHANGED: these were anchored to the repo root, where the Nx workspace used to be
frontend/.sass-cache
frontend/connect.lock
frontend/coverage
frontend/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
frontend/typings

# System Files
.DS_Store
Thumbs.db

# CHANGED: a pattern with a slash in it is relative to this file, so these
# now name the Nx folders inside frontend/
frontend/.nx/cache
frontend/.nx/workspace-data
frontend/.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

.angular

__screenshots__/
vitest.config.*.timestamp*
.vitest

# NEW: .NET build output (every project under backend/ gets these when it builds) -- CHANGED: was api/
bin/
obj/

# NEW: .NET test results and coverage reports
TestResults/
*.trx
coverage.cobertura.xml

# NEW: Visual Studio and Rider local files
.vs/
*.user
*.suo
*.rsuser

# NEW: secrets - real values live only in each server's .env, never in git
.env
.env.*
!.env.example

# NEW: local certificates and keys
*.pfx
*.key
*.pem
