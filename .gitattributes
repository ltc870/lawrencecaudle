# NEW file: .gitattributes
# Line endings: store and check out text files with LF everywhere, on Windows too.
# Bash scripts, Dockerfiles and Caddyfiles break on CRLF, and LF keeps diffs clean.

# Git decides what is text; every text file uses LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binary files.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.pfx binary
